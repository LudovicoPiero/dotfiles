name: "Update Packages"

on:
  workflow_dispatch:
  schedule:
    - cron: "0 16 * * 0"
    - cron: "0 16 * * 3"

jobs:
  update-packages:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v7

      - name: Install Lix
        uses: samueldr/lix-gha-installer-action@latest

      - name: Git config
        run: |
          git config --global user.email "lewdovico@gnuweeb.org"
          git config --global user.name "Ludovico Piero"

      # - name: Run nvfetcher updates
      #   run: |
      #     pushd packages
      #     nix run github:ludovicopiero/nvfetcher -- --commit-changes
      #     popd

      - name: Run nix-update for all flake packages
        run: |
          export LC_ALL=en_US.UTF-8
          export LANG=en_US.UTF-8
          for pkg in iosevka-q; do
            nix run nixpkgs#nix-update -- --flake "$pkg" --commit
          done

      - name: Create or update Pull Request
        uses: peter-evans/create-pull-request@v8
        with:
          token: ${{ secrets.GH_TOKEN_FOR_UPDATES }}
          # Explicitly set the author/committer to match your Git Config
          committer: Ludovico Piero <lewdovico@gnuweeb.org>
          author: Ludovico Piero <lewdovico@gnuweeb.org>
          title: "Automated package updates"
          labels: automated, uwu, keep-up-to-date
          branch: "package-update"
          delete-branch: true
